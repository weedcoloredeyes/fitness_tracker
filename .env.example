# Токен Telegram-бота. Используют сервер и бот; не передавать во фронтенд.
# Не добавляйте префикс VITE_ к секретам.
BOT_TOKEN=
# Публичный HTTPS-адрес Mini App. Нужен процессу бота.
WEB_APP_URL=
# По умолчанию polling. На VPS без исходящего доступа к Telegram: webhook.
# BOT_TRANSPORT=webhook
# Webhook слушает только 127.0.0.1; наружу его публикует HTTPS reverse proxy.
# WEBHOOK_PORT=8081
# Обязателен в webhook: случайный секрет из A-Z, a-z, 0-9, _ и - (1–256 символов).
# WEBHOOK_SECRET=
# Сохранённый успешный getMe (полный ответ или result); по умолчанию этот путь.
# BOT_INFO_FILE=data/bot-info.json
# Необязательно: порт HTTP-сервера, по умолчанию 5173.
# PORT=5173
# Полноценный режим браузера без Telegram. Доступ только с этого компьютера.
# LOCAL_MODE=1
# Числовой ID уже существующего пользователя из локальной базы.
# LOCAL_USER_ID=
